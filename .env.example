NODE_ENV=development
PORT=4000
# Database migration role (privileged, for running migrations)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brightloop?schema=public
# Database runtime application role (restricted, NOSUPERUSER, NOBYPASSRLS - enforces RLS)
DATABASE_APP_URL=postgresql://brightloop_app:brightloop_app_pass@localhost:5432/brightloop?schema=public
# Redis queue & cache
REDIS_URL=redis://localhost:6379
# JWT Security
JWT_ACCESS_SECRET=brightloop_development_super_secret_jwt_access_key_32bytes_long!!
JWT_REFRESH_SECRET=brightloop_development_super_secret_jwt_refresh_key_32bytes_long!!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Payment Gateway (Razorpay sandbox defaults)
RAZORPAY_KEY_ID=rzp_test_demo_id
RAZORPAY_KEY_SECRET=rzp_test_demo_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret
