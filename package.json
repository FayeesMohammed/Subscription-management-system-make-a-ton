{
  "name": "brightloop-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @brightloop/api db:generate",
    "db:migrate": "pnpm --filter @brightloop/api db:migrate",
    "db:seed": "pnpm --filter @brightloop/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
